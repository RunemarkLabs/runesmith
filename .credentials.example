# RuneSmith credentials layout. Copy the blocks you need; never commit a real
# .credentials file (both locations are gitignored).
#
# Planner keys go in {WORKSPACE_ROOT}/.credentials.
# Claude Code keys go in {PROJECT}.cc/.credentials (beside the repos, never inside one).
# Every value is single-quoted, including empty ones.

# ============================================================
# {WORKSPACE_ROOT}/.credentials
# ============================================================

# ------------------------------------------------------------
# GitHub (planner)
# Owner: runesmith
# Console: https://github.com/settings/personal-access-tokens
# ------------------------------------------------------------
RUNESMITH_GITHUB_PAT=''

# ------------------------------------------------------------
# Atlassian (planner)
# Owner: runesmith
# Console: https://id.atlassian.com/manage-profile/security/api-tokens
# ------------------------------------------------------------
ATLASSIAN_API_URL=''
ATLASSIAN_API_EMAIL=''
ATLASSIAN_API_TOKEN=''
ATLASSIAN_CONFLUENCE_SPACE_ID=''
ATLASSIAN_JIRA_PROJECT_KEY=''
ATLASSIAN_DEFAULT_ASSIGNEE_ACCOUNT_ID=''
ATLASSIAN_BUG_SEVERITY_FIELD=''

# ------------------------------------------------------------
# Plugin sources (planner, optional)
# Owner: runesmith
# ------------------------------------------------------------
PLUGIN_SOURCES=''

# ============================================================
# {PROJECT}.cc/.credentials (only when Jira is enabled)
# ============================================================

# ------------------------------------------------------------
# Atlassian (Claude Code, read-only)
# Owner: runesmith
# Console: https://id.atlassian.com/manage-profile/security/api-tokens
# ------------------------------------------------------------
CC_ATLASSIAN_API_EMAIL=''
CC_ATLASSIAN_API_TOKEN=''
ATLASSIAN_BOARD_ID=''
